---
import Base from '../layouts/Base.astro';
import Highlight from '../components/ui/Highlight.astro';
import Button from '../components/ui/Button.astro';
import { isoBox } from '../lib/iso';
import { useT } from '../lib/i18n';

const t = useT('en');
const tes = useT('es');
const box = isoBox(0, 0, 4, 4, 1.5);
---

<Base locale="en" title="404 · Peter G. Lobo">
  <section class="container-col flex min-h-[80vh] flex-col items-start justify-center gap-6 pt-14">
    <svg viewBox="-110 -60 220 170" class="h-40 w-auto" aria-hidden="true">
      <path d="M-100,60 L0,110 L100,60 L0,10Z" fill="none" stroke="var(--line-divider)" stroke-dasharray="4 4" />
      <g class="fall">
        <path d={box.left} fill="var(--surface-1)" stroke="var(--line-strong)" />
        <path d={box.right} fill="var(--surface-2)" stroke="var(--line-strong)" />
        <path d={box.top} fill="var(--highlight)" stroke="var(--line-strong)" />
      </g>
    </svg>
    <h1 class="t-h2">
      <Highlight text={t.notFound.title} />
    </h1>
    <p class="t-body">
      {t.notFound.body} <span class="text-text-disabled">/ {tes.notFound.body}</span>
    </p>
    <div class="-ml-1 flex gap-1">
      <Button href="/" trailing="arrow-right">
        {t.notFound.back}
      </Button>
      <Button href="/es/">{tes.notFound.back}</Button>
    </div>
  </section>
</Base>

<style>
  .fall {
    animation: fall 2.4s cubic-bezier(0.5, 0, 0.75, 0) infinite;
  }
  @keyframes fall {
    0% {
      transform: translateY(-80px);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    55% {
      transform: translateY(40px) rotate(0deg);
      opacity: 1;
    }
    70%,
    100% {
      transform: translateY(160px) rotate(12deg);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .fall {
      animation: none;
    }
  }
</style>
