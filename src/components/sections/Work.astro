---
import SectionHead from '../ui/SectionHead.astro';
import { experience, extras } from '../../content/experience';
import { pick, useT, type Locale } from '../../lib/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useT(locale);
const fmt = new Intl.DateTimeFormat(locale, { month: 'short', year: 'numeric', timeZone: 'UTC' });
const date = (ym: string | null) => (ym ? fmt.format(new Date(`${ym}-01T00:00:00Z`)) : t.work.now);
---

<section id="work" class="section container-col reveal">
  <SectionHead eyebrow={t.work.eyebrow} title={t.work.title} body={t.work.body} />

  <ol class="relative mt-10 flex flex-col gap-6" data-timeline>
    <span class="absolute bottom-2 left-[5px] top-2 w-px bg-line" aria-hidden="true"></span>
    <span class="tl-line absolute bottom-2 left-[5px] top-2 w-px bg-text-primary" aria-hidden="true"></span>
    {experience.map((c) => (
      <li class="tl-item relative pl-8">
        <span
          class="tl-dot absolute left-0 top-[3px] h-[11px] w-[11px] rounded-full border border-line-strong bg-surface-bg"
          aria-hidden="true"
        />
        <p class="font-mono text-[11px] text-text-disabled">
          {date(c.roles.at(-1)!.start)} → {date(c.roles[0].end)}
        </p>
        <article class="cbox cbox-hover mt-2 p-4 sm:p-5" data-cursor="frame">
          <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="text-[17px] font-medium tracking-[-0.01em]">{c.name}</h3>
            {c.restricted && <span class="chip">🔒 {t.work.private}</span>}
          </header>
          {c.roles.map((r, ri) => (
            <div class:list={[ri > 0 && 'mt-5']}>
              <p class="mt-1 flex flex-wrap items-baseline justify-between gap-x-3 text-[14px] text-text-secondary">
                <span>
                  {r.title}
                  {r.client && <span class="text-text-tertiary"> · {pick(r.client, locale)}</span>}
                </span>
                {c.roles.length > 1 && (
                  <span class="font-mono text-[11px] text-text-disabled">
                    {date(r.start)} → {date(r.end)}
                  </span>
                )}
              </p>
              <ul class="mt-2.5 flex flex-col gap-1.5 text-[14px] text-text-tertiary">
                {pick(r.bullets, locale).map((b) => (
                  <li class="relative pl-4 before:absolute before:left-0.5 before:top-[0.55em] before:h-1 before:w-1 before:rounded-full before:bg-text-disabled">
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <div class="mt-4 flex flex-wrap gap-1.5">
            {c.stack.map((s) => (
              <span class="chip">{s}</span>
            ))}
          </div>
        </article>
      </li>
    ))}
  </ol>

  <div class="mt-8 flex flex-col gap-1.5 pl-8 font-mono text-[11.5px] text-text-tertiary">
    {pick(extras, locale).map((e) => (
      <p>{e}</p>
    ))}
  </div>
</section>
