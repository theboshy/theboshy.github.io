---
import { useT, type Locale } from '../../lib/i18n';
import { profile } from '../../content/profile';

interface Props {
  locale: Locale;
}
const t = useT(Astro.props.locale);
---

<footer class="container-col mt-24 border-t border-line py-6">
  <div class="flex flex-col justify-between gap-2 font-mono text-[11px] text-text-disabled sm:flex-row">
    <p>
      © {new Date().getFullYear()} {profile.name}
    </p>
    <p class="flex gap-3">
      <a href={profile.repo} target="_blank" rel="noopener noreferrer" class="hover:text-text-primary">
        {t.footer.source} ↗
      </a>
      <span data-clock aria-label="Bogotá time"></span>
    </p>
  </div>
</footer>
