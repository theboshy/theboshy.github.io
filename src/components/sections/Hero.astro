---
import Highlight from '../ui/Highlight.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { useT, type Locale } from '../../lib/i18n';
import { profile } from '../../content/profile';

interface Props {
  locale: Locale;
}
const t = useT(Astro.props.locale);
---

<section class="relative flex min-h-[86vh] items-center pt-14">
  <div class="dot-grid" data-parallax aria-hidden="true"></div>
  <div class="container-col hero-in relative flex flex-col items-start gap-6">
    <p class="t-mono text-text-disabled">{t.hero.eyebrow}</p>
    <h1 class="t-display max-w-[17ch] text-text-primary">
      <Highlight text={t.hero.title} />
    </h1>
    <p class="t-body max-w-[52ch] text-[16px]">{t.hero.subtitle}</p>
    <div class="-ml-1 flex flex-wrap items-center gap-1">
      <Button href={profile.github} variant="primary" brandIcon="github" external beam>
        GitHub
      </Button>
      <Button href={profile.linkedin} trailing="arrow-up-right" external>
        LinkedIn
      </Button>
      <Button href={`mailto:${profile.email}`} icon="mail">
        {t.hero.email}
      </Button>
    </div>
    <p class="flex items-center gap-1.5 font-mono text-[11.5px] text-text-disabled">
      <Icon name="map-pin" size={13} />
      {t.hero.location}
    </p>
  </div>
</section>
